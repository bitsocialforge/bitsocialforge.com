{
  "name": "bitsocialforge.com",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://bitsocialforge.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitsocialforge/bitsocialforge.com.git"
  },
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "start": "node --experimental-strip-types scripts/start-dev.mts",
    "dev": "corepack yarn start",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "type-check": "node --experimental-strip-types scripts/check-typescript-sources.mts && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "oxlint src scripts vite.config.ts",
    "format": "oxfmt src scripts vite.config.ts",
    "ai-workflow:sync": "node --experimental-strip-types scripts/sync-ai-workflow.mts",
    "ai-workflow:check": "node --experimental-strip-types scripts/validate-ai-workflow.mts",
    "ai-workflow:test": "node --experimental-strip-types --test --test-concurrency=1 scripts/__tests__/ai-workflow.node-test.mts scripts/__tests__/agent-hooks.node-test.mts",
    "agent:verify": "bash scripts/verify.sh",
    "test:scripts": "node --experimental-strip-types --test --test-concurrency=1 scripts/*.test.mts scripts/__tests__/*.mts scripts/jev/tests/*.test.mts scripts/visual-qa/tests/*.test.mts"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "agentation": "3.0.2",
    "cross-spawn": "7.0.6",
    "js-yaml": "4.3.2",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "smol-toml": "1.7.1",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "optionalDependencies": {
    "portless": "0.11.1"
  },
  "resolutions": {
    "nanoid@npm:^3.3.16": "npm:3.3.18",
    "postcss": "8.5.23",
    "tar": "7.5.22",
    "undici@npm:^8.4.1": "npm:8.10.2"
  }
}
