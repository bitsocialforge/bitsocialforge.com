{
  "cleanUrls": true,
  "installCommand": "corepack enable && corepack yarn install --immutable",
  "buildCommand": "corepack yarn build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.bitsocialforge.com" }],
      "destination": "https://bitsocialforge.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
